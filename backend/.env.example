# Required: your MongoDB connection string and a random signing secret.
MONGODB_URI=
JWT_SECRET=

# Local defaults. Set CLIENT_URL to your frontend URL when deploying.
PORT=5000
CLIENT_URL=http://localhost:5173

# Required for email PIN password recovery. Use your mail provider's SMTP settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
